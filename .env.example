# ALTIORA MENU — variáveis de ambiente (a configuração do servidor).
#
# · No seu computador: copie este ficheiro para «.env» e preencha. (O ficheiro «.env» NUNCA vai para o GitHub.)
# · No Render: preencha estas variáveis no painel do serviço, em «Environment». Não envie valores reais por e-mail
#   nem os escreva em locais públicos: a palavra-passe da base de dados dá acesso a todos os dados.
# Linhas que começam por # são comentários. Os valores abaixo são os que o servidor usa quando a variável não existe.

# ===== OBRIGATÓRIAS ==========================================================================================
# Endereço da base de dados PostgreSQL. No Supabase: Connect → «Session pooler» (copie o endereço e troque
# [YOUR-PASSWORD] pela palavra-passe da base de dados).
DATABASE_URL=postgresql://postgres.abcdefghij:A-SUA-PALAVRA-PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ===== BASE DE DADOS =========================================================================================
# require = ligação sempre cifrada (obrigatório com o Supabase). disable = só para uma base de dados no seu computador.
DATABASE_SSL=require
# Número máximo de ligações abertas à base de dados.
DATABASE_POOL_MAX=10
# Ponha false SÓ se usar o «Transaction pooler» do Supabase (porta 6543). Com o «Session pooler» (recomendado), deixe true.
DATABASE_PREPARE=true
# Cria e atualiza as tabelas e as regras de segurança sozinho ao arrancar. Deixe true.
AUTO_MIGRATE=true

# ===== ENDEREÇO E SEGURANÇA ==================================================================================
# Em produção tem de começar por https://. No Render, se não definir, usa o endereço do próprio Render.
# ATENÇÃO: os QR Codes das mesas levam este endereço. Se mudar de domínio, os QR Codes impressos deixam de funcionar.
PUBLIC_BASE_URL=https://menu.exemplo.ao
# Outros endereços (separados por vírgulas) de onde a aplicação pode ser usada. Quase nunca é preciso.
ALLOWED_ORIGINS=
# Quantos servidores ficam entre a internet e a aplicação (no Render: 1).
TRUST_PROXY_HOPS=1
NODE_ENV=production
# true/false. Por omissão fica true em produção.
COOKIE_SECURE=true

# ===== PRIMEIRA CONTA DA ALTIORA (administração da plataforma) ===============================================
# Só funcionam as duas em conjunto, e só criam a conta se ainda não existir nenhum administrador.
# A palavra-passe tem de ter pelo menos 10 caracteres e é obrigatório trocá-la no primeiro acesso.
# Depois de entrar, APAGUE as duas variáveis.
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.ao
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador Altiora

# ===== PÁGINA COMERCIAL E RESTAURANTE DE DEMONSTRAÇÃO ========================================================
# Contactos mostrados na página comercial (só aparecem os que preencher).
COMMERCIAL_EMAIL=comercial@exemplo.ao
COMMERCIAL_PHONE=+244 900 000 000
# Número do WhatsApp comercial, com o indicativo do país (+244). Dá o botão «Falar no WhatsApp».
COMMERCIAL_WHATSAPP=+244900000000
COMMERCIAL_ADDRESS=Luanda, Angola
# Endereço do restaurante de demonstração (o que a página comercial mostra), por exemplo /r/demo
DEMO_RESTAURANT_SLUG=demo
# true = ao arrancar, cria o restaurante de demonstração «Casa Aurora» se ainda não existir. Pode apagar depois.
SEED_SHOWCASE=false

# ===== LIMITES (os valores por omissão servem para quase todos os restaurantes) ==============================
# Espaço máximo de fotografias e modelos 3D por restaurante, em MB.
ASSET_QUOTA_MB=80
# Duração das sessões: horas sem atividade / dias no máximo.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=14
# Quanto tempo a mesa pode continuar a pedir depois de ler o QR Code (minutos).
TABLE_SESSION_MINUTES=240
# Pedidos por preparar que uma mesa pode ter ao mesmo tempo / segundos mínimos entre pedidos da mesma mesa.
MAX_PENDING_ORDERS_PER_TABLE=8
MIN_SECONDS_BETWEEN_ORDERS=3
# Proteção contra abusos (tentativas de entrada, pedidos em excesso). Deixe true.
RATE_LIMIT_ENABLED=true

# ===== AVANÇADAS (normalmente não é preciso mexer) ===========================================================
# Porta onde o servidor ouve (o Render define-a sozinho).
PORT=3000
HOST=0.0.0.0
# Custo do cálculo das palavras-passe (10 a 17). Mais alto = mais seguro, mais lento.
SCRYPT_LOG_N=15
# debug | info | warn | error
LOG_LEVEL=info
WEB_DIR=./dist/web
MIGRATIONS_DIR=./db/migrations
DEMO_MEDIA_DIR=./scripts/demo-media/assets
